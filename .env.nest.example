# Machine Identity criada na UI do Infisical
# (Organization Access Control > Machine Identities > Create > Universal Auth)
# Nomes são os que o CLI do Infisical lê automaticamente — não mude.
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=REPLACE_WITH_CLIENT_ID
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
